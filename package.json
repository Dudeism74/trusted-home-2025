{
  "name": "trusted-home-essentials-hub",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "bash scripts/install-ci.sh",
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vite",
    "build": "bash scripts/build-platform.sh",
    "build:sites": "bash scripts/build-verified.sh",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "indexnow:submit": "node scripts/submit-indexnow.mjs",
    "indexnow:dry-run": "INDEXNOW_DRY_RUN=1 node scripts/submit-indexnow.mjs",
    "test": "npm run build && node --experimental-loader=./scripts/cloudflare-workers-loader.mjs --test tests/rendered-html.test.mjs",
    "validate:artifact": "bash scripts/validate-artifact.sh",
    "lint": "bash scripts/sites-env.sh -- eslint . --ignore-pattern dist --ignore-pattern .next"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "next": "16.4.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.64.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "eslint": "10.13.0",
    "eslint-config-next": "16.4.1",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.1.6",
    "wrangler": "4.152.0"
  },
  "type": "module",
  "displayName": "Trusted Home Essentials",
  "overrides": {
    "image-size": "2.0.4"
  }
}
